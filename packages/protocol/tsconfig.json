{
  "compilerOptions": {
    // No platform: no DOM, no Bun and no Node types. `types: []` keeps every
    // `@types/*` package out, so `Bun.*`, `process` and `node:*` do not type-check here.
    "lib": ["ESNext"],
    "types": [],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*"]
}
