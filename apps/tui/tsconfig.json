{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // The entries of `gambi-sdk` the TUI uses, from their source: the
    // package's own `exports` point at `dist/`, which only exists after a
    // build.
    "paths": {
      "gambi-sdk": ["../../packages/sdk/src/index.ts"],
      "gambi-sdk/hub": ["../../packages/sdk/src/hub.ts"],
      "gambi-sdk/participant": ["../../packages/sdk/src/participant.ts"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // The built bundle is JavaScript (`allowJs`), and it embeds Effect: the
  // compiler overflows its stack on it.
  "exclude": ["dist", "node_modules"]
}
