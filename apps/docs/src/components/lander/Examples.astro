<script>
  interface Move {
    n: number;
    dir: "out" | "back";
    stop?: boolean;
  }
  interface Step {
    moves?: Move[];
    ev?: string;
    text: string;
    stop?: boolean;
  }
  interface Stage {
    id: string;
    nodes: { x: number; y: number; a: number }[];
    steps: Step[];
  }

  const NS = "http://www.w3.org/2000/svg";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const root = document.querySelector<HTMLElement>("[data-examples]");

  if (root) {
    const data: Stage[] = JSON.parse(root.dataset.examples ?? "[]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const stages = [...root.querySelectorAll<SVGSVGElement>("[data-stage]")];
    const log = root.querySelector<HTMLOListElement>("[data-log]");

    let current = data[0]?.id ?? "";
    let run = 0;
    let visible = false;

    const line = (step: Step, animate: boolean) => {
      if (!log) return;
      const li = document.createElement("li");
      if (step.stop) li.classList.add("log-stop");
      if (animate) li.classList.add("is-new");
      if (step.ev) {
        const code = document.createElement("code");
        code.textContent = step.ev;
        li.append(code, " ");
      }
      li.append(step.text);
      log.append(li);
    };

    const fillLog = (stage: Stage) => {
      if (!log) return;
      log.replaceChildren();
      stage.steps.forEach((s) => line(s, false));
    };

    const wait = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));

    // cubic-bezier(0.77, 0, 0.175, 1), solved numerically: tokens follow the
    // curved track, so the motion is driven frame by frame.
    const easeInOut = (() => {
      const [p1x, p1y, p2x, p2y] = [0.77, 0, 0.175, 1];
      const cx = 3 * p1x;
      const bx = 3 * (p2x - p1x) - cx;
      const ax = 1 - cx - bx;
      const cy = 3 * p1y;
      const by = 3 * (p2y - p1y) - cy;
      const ay = 1 - cy - by;
      return (p: number) => {
        let t = p;
        for (let i = 0; i < 6; i++) {
          const x = ((ax * t + bx) * t + cx) * t - p;
          const d = (3 * ax * t + 2 * bx) * t + cx;
          if (Math.abs(d) < 1e-6) break;
          t -= x / d;
        }
        t = Math.min(1, Math.max(0, t));
        return ((ay * t + by) * t + cy) * t;
      };
    })();

    const travel = (svg: SVGSVGElement, _stage: Stage, move: Move) =>
      new Promise<void>((resolve) => {
        const layer = svg.querySelector(".st-tokens");
        const track = svg.querySelector<SVGPathElement>(`[data-track="${move.n}"]`);
        if (!layer || !track) return resolve();
        const len = track.getTotalLength();
        // The track runs node -> hub.
        const [from, to] = move.dir === "out" ? [len, 0] : [0, len];
        const harness = track.classList.contains("st-track-harness");
        const dot = document.createElementNS(NS, "circle");
        dot.setAttribute("r", "7");
        const kindColor = harness ? "var(--e-harness)" : "var(--e-model)";
        dot.style.fill = move.stop ? "var(--e-stop)" : kindColor;
        dot.style.stroke = "var(--e-ground)";
        dot.style.strokeWidth = "3";
        layer.append(dot);
        track.classList.add("is-live");
        const start = performance.now();
        const duration = 760;
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / duration);
          const pt = track.getPointAtLength(from + (to - from) * easeInOut(p));
          dot.setAttribute("cx", pt.x.toFixed(1));
          dot.setAttribute("cy", pt.y.toFixed(1));
          if (p < 1) {
            requestAnimationFrame(step);
            return;
          }
          dot.remove();
          track.classList.remove("is-live");
          if (move.dir === "out") {
            const g = svg.querySelector(`[data-node="${move.n}"]`);
            g?.classList.add("is-hit");
            window.setTimeout(() => g?.classList.remove("is-hit"), 380);
          }
          resolve();
        };
        requestAnimationFrame(step);
      });

    const play = async (id: string) => {
      const token = ++run;
      const stage = data.find((s) => s.id === id);
      const svg = stages.find((s) => s.dataset.stage === id);
      if (!stage || !svg) return;
      while (token === run) {
        log?.replaceChildren();
        for (const step of stage.steps) {
          if (token !== run) return;
          while (!visible || document.hidden) {
            await wait(300);
            if (token !== run) return;
          }
          line(step, true);
          if (step.moves?.length) {
            await Promise.all(step.moves.map((m) => travel(svg, stage, m)));
            await wait(260);
          } else {
            await wait(900);
          }
        }
        await wait(2200);
      }
    };

    const select = (id: string, focus = false) => {
      current = id;
      tabs.forEach((t) => {
        const on = t.dataset.ex === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => {
        p.hidden = p.id !== `ex-panel-${id}`;
      });
      // SVG elements have no .hidden property; toggle the attribute.
      stages.forEach((s) => s.toggleAttribute("hidden", s.dataset.stage !== id));
      const stage = data.find((s) => s.id === id);
      if (reduce.matches) {
        run++;
        if (stage) fillLog(stage);
      } else {
        void play(id);
      }
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t.dataset.ex ?? ""));
      t.addEventListener("keydown", (ev) => {
        const delta = ev.key === "ArrowRight" ? 1 : ev.key === "ArrowLeft" ? -1 : 0;
        if (!delta) return;
        ev.preventDefault();
        const next = tabs[(i + delta + tabs.length) % tabs.length];
        select(next.dataset.ex ?? "", true);
      });
    });

    new IntersectionObserver(
      (entries) => {
        visible = entries.some((en) => en.isIntersecting);
      },
      { threshold: 0.3 }
    ).observe(root);

    if (!reduce.matches) void play(current);
  }
</script>
