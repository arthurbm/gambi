---
import { fix, polar } from "./geometry";

type Kind = "model" | "harness";

interface Node {
  name: string;
  offer: string;
  kind: Kind;
  a: number;
}

interface Move {
  n: number;
  dir: "out" | "back";
  stop?: boolean;
}

interface Step {
  moves?: Move[];
  ev?: string;
  text: string;
  stop?: boolean;
}

interface Example {
  id: string;
  tab: string;
  title: string;
  body: string;
  href: string;
  link: string;
  explored?: boolean;
  nodes: Node[];
  steps: Step[];
}

// Illustrative sessions. Event and frame names are the real ones from
// packages/core; people, models, and timings are made up.
const examples: Example[] = [
  {
    id: "arena",
    tab: "Model arena",
    title: "Model arena",
    body: "Send one prompt to every model in the room and compare the answers side by side, with timing from the room's events.",
    href: "/guides/patterns/#model-arena",
    link: "See the pattern",
    nodes: [
      { name: "Arthur", offer: "llama3", kind: "model", a: -135 },
      { name: "Lu", offer: "qwen2.5-coder", kind: "model", a: -45 },
      { name: "Tati", offer: "llama-3.3-70b", kind: "model", a: 45 },
      { name: "Gabi", offer: "mistral-small", kind: "model", a: 135 },
    ],
    steps: [
      {
        moves: [0, 1, 2, 3].map((n) => ({ n, dir: "out" })),
        ev: "llm.request",
        text: "one prompt, four models",
      },
      {
        moves: [{ n: 1, dir: "back" }],
        ev: "llm.complete",
        text: "qwen2.5-coder · ttft 210 ms",
      },
      {
        moves: [{ n: 0, dir: "back" }],
        ev: "llm.complete",
        text: "llama3 · ttft 340 ms",
      },
      {
        moves: [{ n: 3, dir: "back" }],
        ev: "llm.complete",
        text: "mistral-small · ttft 410 ms",
      },
      {
        moves: [{ n: 2, dir: "back" }],
        ev: "llm.complete",
        text: "llama-3.3-70b · ttft 620 ms",
      },
      { text: "Your app shows the four answers side by side." },
    ],
  },
  {
    id: "jury",
    tab: "Jury panel",
    title: "Jury panel",
    body: "One model answers and three others score it. Each judge can run on a different person's machine.",
    href: "/guides/patterns/#jury-panel",
    link: "See the pattern",
    nodes: [
      { name: "Arthur", offer: "llama3", kind: "model", a: -90 },
      { name: "Lu", offer: "qwen2.5-coder", kind: "model", a: 30 },
      { name: "Gabi", offer: "mistral-small", kind: "model", a: 90 },
      { name: "Tati", offer: "llama-3.3-70b", kind: "model", a: 150 },
    ],
    steps: [
      {
        moves: [{ n: 0, dir: "out" }],
        ev: "llm.request",
        text: "llama3 writes the answer",
      },
      {
        moves: [{ n: 0, dir: "back" }],
        ev: "llm.complete",
        text: "answer ready",
      },
      {
        moves: [1, 2, 3].map((n) => ({ n, dir: "out" })),
        ev: "llm.request",
        text: "three judges score it",
      },
      {
        moves: [{ n: 1, dir: "back" }],
        ev: "llm.complete",
        text: "qwen2.5-coder · 8 / 10",
      },
      {
        moves: [{ n: 3, dir: "back" }],
        ev: "llm.complete",
        text: "llama-3.3-70b · 7 / 10",
      },
      {
        moves: [{ n: 2, dir: "back" }],
        ev: "llm.complete",
        text: "mistral-small · 9 / 10",
      },
      { text: "Your app averages the scores: 8.0." },
    ],
  },
  {
    id: "debate",
    tab: "Debate",
    title: "Debate club",
    body: "Two models argue in turns while a third moderates. Your code decides who speaks next and what each one sees.",
    href: "/guides/patterns/#debate-club",
    link: "See the pattern",
    nodes: [
      { name: "Arthur", offer: "llama3 · moderator", kind: "model", a: -90 },
      { name: "Tati", offer: "llama-3.3-70b · against", kind: "model", a: 30 },
      { name: "Lu", offer: "qwen2.5-coder · for", kind: "model", a: 150 },
    ],
    steps: [
      {
        moves: [{ n: 2, dir: "out" }],
        ev: "llm.request",
        text: "turn 1 · for",
      },
      {
        moves: [{ n: 2, dir: "back" }],
        ev: "llm.complete",
        text: "argument received",
      },
      {
        moves: [{ n: 1, dir: "out" }],
        ev: "llm.request",
        text: "turn 1 · against, sees the argument",
      },
      {
        moves: [{ n: 1, dir: "back" }],
        ev: "llm.complete",
        text: "rebuttal received",
      },
      {
        moves: [{ n: 2, dir: "out" }],
        ev: "llm.request",
        text: "turn 2 · for",
      },
      {
        moves: [{ n: 2, dir: "back" }],
        ev: "llm.complete",
        text: "closing received",
      },
      {
        moves: [{ n: 0, dir: "out" }],
        ev: "llm.request",
        text: "moderator reads both sides",
      },
      {
        moves: [{ n: 0, dir: "back" }],
        ev: "llm.complete",
        text: "summary and verdict",
      },
    ],
  },
  {
    id: "chain",
    tab: "Draft, critique, polish",
    title: "Draft, critique, polish",
    body: "A small local model drafts, a stronger one critiques, and the first one revises. Cheap where it can be, strong where it counts.",
    href: "/guides/patterns/#draft-critique-polish",
    link: "See the pattern",
    nodes: [
      { name: "Arthur", offer: "llama3 · local", kind: "model", a: 180 },
      { name: "Tati", offer: "llama-3.3-70b", kind: "model", a: 0 },
    ],
    steps: [
      { moves: [{ n: 0, dir: "out" }], ev: "llm.request", text: "draft" },
      {
        moves: [{ n: 0, dir: "back" }],
        ev: "llm.complete",
        text: "draft · 1.2 s",
      },
      {
        moves: [{ n: 1, dir: "out" }],
        ev: "llm.request",
        text: "critique the draft",
      },
      {
        moves: [{ n: 1, dir: "back" }],
        ev: "llm.complete",
        text: "three notes",
      },
      {
        moves: [{ n: 0, dir: "out" }],
        ev: "llm.request",
        text: "revise with the notes",
      },
      {
        moves: [{ n: 0, dir: "back" }],
        ev: "llm.complete",
        text: "final text",
      },
    ],
  },
  {
    id: "squads",
    tab: "Squads",
    title: "Squads with a steerer",
    body: "Squads of people build something together, each squad with its own coding agent. Each round one person steers: they record a decision before work goes to the agent, then accept the result or send it back with a reason. Those rules are app code; Gambi carries the messages.",
    href: "/explanation/whats-next/",
    link: "Where this is going",
    explored: true,
    nodes: [
      { name: "Squad A", offer: "Bia · claude-code", kind: "harness", a: -90 },
      { name: "Squad B", offer: "Caio · codex", kind: "harness", a: 30 },
      { name: "Squad C", offer: "Duda · opencode", kind: "harness", a: 150 },
    ],
    steps: [
      { text: "Round 1 · the challenge goes to every squad" },
      { text: "Squad A records a decision, Bia steering" },
      {
        moves: [{ n: 0, dir: "out" }],
        ev: "tunnel.harness.message",
        text: "dispatch to Bia's claude-code",
      },
      {
        moves: [{ n: 0, dir: "back" }],
        ev: "tunnel.harness.artifact",
        text: "v1 · 3 files",
      },
      { text: "Bia accepts" },
      {
        moves: [{ n: 1, dir: "out" }],
        ev: "tunnel.harness.message",
        text: "dispatch to Caio's codex",
      },
      {
        moves: [{ n: 1, dir: "back" }],
        ev: "tunnel.harness.artifact",
        text: "v1 · 2 files",
      },
      { text: "Caio returns it: missing tests", stop: true },
      {
        moves: [{ n: 1, dir: "out", stop: true }],
        ev: "tunnel.harness.message",
        text: "dispatched again, with the reason",
      },
      {
        moves: [{ n: 1, dir: "back" }],
        ev: "tunnel.harness.artifact",
        text: "v2 · accepted",
      },
      { text: "Round 2 · steering passes to the next person" },
    ],
  },
];

const stageData = examples.map((ex) => ({
  id: ex.id,
  nodes: ex.nodes.map((n) => {
    const [x, y] = polar(140, n.a);
    return { x: Number(fix(x)), y: Number(fix(y)), a: n.a };
  }),
  steps: ex.steps,
}));

// A small event display: nodes sit on a machine band at r = 140 and every
// track bends the same way into the hub, like the hero.
const BAND = 140;
const stageTrack = (a: number) => {
  const [x0, y0] = polar(BAND - 8, a);
  const [cx, cy] = polar(84, a + 14);
  const [x1, y1] = polar(30, a + 22);
  return `M${fix(x0)} ${fix(y0)} Q${fix(cx)} ${fix(cy)} ${fix(x1)} ${fix(y1)}`;
};
const stageWedge = (a: number) => {
  const [x0, y0] = polar(BAND + 12, a - 6);
  const [x1, y1] = polar(BAND + 12, a + 6);
  return `M${fix(x0)} ${fix(y0)} A${BAND + 12} ${BAND + 12} 0 0 1 ${fix(x1)} ${fix(y1)}`;
};

// Labels sit outside the node, hanging away from the hub.
const label = (a: number) => {
  const [x, y] = polar(184, a);
  let anchor = "middle";
  const dx = 0;
  if (Math.abs(x) >= 30) {
    anchor = x > 0 ? "start" : "end";
  }
  let dy = 0;
  if (y < -100) {
    dy = -6;
  } else if (y > 100) {
    dy = 14;
  }
  return { x: fix(x + dx), y: fix(y + dy), anchor };
};
---

<section class="examples" aria-labelledby="examples-title">
  <h2 id="examples-title" class="section-title">What a group can build on it</h2>
  <p class="section-lead">
    Pick an example. Each one is your app's code running on one hub, with
    participants on different machines. The events are illustrative.
  </p>

  <div class="ex" data-examples={JSON.stringify(stageData)}>
    <div class="ex-tabs" role="tablist" aria-label="Examples">
      {examples.map((ex, i) => (
        <button
          role="tab"
          type="button"
          id={`ex-tab-${ex.id}`}
          aria-controls={`ex-panel-${ex.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-ex={ex.id}
        >
          {ex.tab}
        </button>
      ))}
    </div>

    <div class="ex-body">
      <div class="ex-copy">
        {examples.map((ex, i) => (
          <div class="ex-panel" role="tabpanel" id={`ex-panel-${ex.id}`} aria-labelledby={`ex-tab-${ex.id}`} hidden={i !== 0}>
            <h3 class="ex-title">
              {ex.title}
              {ex.explored && <span class="tag-explored">Being explored</span>}
            </h3>
            <p>{ex.body}</p>
            <a class="ex-link" href={ex.href}>{ex.link}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l5 5-5 5"></path></svg></a>
          </div>
        ))}
      </div>

      <div class="ex-stage" aria-hidden="true">
        {examples.map((ex, i) => (
          <svg class="stage" viewBox="-240 -222 480 470" data-stage={ex.id} hidden={i !== 0}>
            <circle class="st-band" r={BAND}></circle>
            <circle class="st-hair" r={BAND - 8}></circle>
            <circle class="st-hair" r={BAND + 8}></circle>
            <circle class="st-hair st-tunnel" r="90"></circle>
            {ex.nodes.map((n, k) => (
              <path class:list={["st-track", `st-track-${n.kind}`]} data-track={k} d={stageTrack(n.a)}></path>
            ))}
            {ex.nodes.map((n) => (
              <path class="st-wedge" d={stageWedge(n.a)}></path>
            ))}
            <circle class="st-hub-ring" r="32"></circle>
            <circle class="st-hub" r="24"></circle>
            <text class="st-hub-label" y="5" text-anchor="middle">hub</text>
            {ex.nodes.map((n, k) => {
              const [x, y] = polar(140, n.a);
              const l = label(n.a);
              return (
                <g class:list={["st-node", `st-${n.kind}`]} data-node={k}>
                  <circle class="st-dot" cx={fix(x)} cy={fix(y)} r="10"></circle>
                  <text class="st-name" x={l.x} y={l.y} text-anchor={l.anchor}>{n.name}</text>
                  <text class="st-offer" x={l.x} y={Number(l.y) + 20} text-anchor={l.anchor}>{n.offer}</text>
                </g>
              );
            })}
            <g class="st-tokens"></g>
          </svg>
        ))}
        <div class="log-frame">
          <ol class="log" data-log>
            {examples[0].steps.map((s) => (
              <li class:list={[s.stop && "log-stop"]}>{s.ev && <code>{s.ev}</code>} {s.text}</li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ex {
    margin-top: 2.4rem;
  }

  .ex-tabs {
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--e-line-2);
  }

  .ex-tabs button {
    flex: none;
    border: 0;
    background: transparent;
    padding: 0.65rem 0.9rem;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    font-variation-settings: "wdth" 96;
    color: var(--e-ink-3);
    cursor: pointer;
    border-radius: 8px 8px 0 0;
    box-shadow: inset 0 -2px 0 transparent;
    transition: color 160ms ease, box-shadow 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
