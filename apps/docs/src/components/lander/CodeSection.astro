---
import { Code } from "astro:components";

const modelSnippet = `import { generateText } from "ai";
import { createGambi } from "gambi-sdk";

const gambi = createGambi({
  roomCode: "ABC123",
  hubUrl: "http://192.168.1.10:3000",
});

const { text } = await generateText({
  model: gambi.model("llama3"), // or gambi.any()
  prompt: "Draft the release note for v0.7.",
});`;

const agentSnippet = `import { createClient } from "gambi-sdk";

const client = createClient({ hubUrl: "http://192.168.1.10:3000" });

// Bia's Claude Code, running on Bia's laptop
const channel = await client.harness.attach({
  roomCode: "ABC123",
  participantId: "bia",
});

for await (const frame of channel.messages) {
  if (frame.type === "tunnel.harness.artifact") {
    console.log(frame.files.map((f) => f.path));
  }
}`;

const links = [
  {
    title: "Quick start",
    note: "Hub, room, and your first participant in four commands.",
    href: "/guides/quickstart/",
  },
  {
    title: "Bring your agent",
    note: "Share Claude Code, Codex, or OpenCode from your machine.",
    href: "/guides/bring-your-harness/",
  },
  {
    title: "Patterns",
    note: "Arena, jury, debate, and the rest, with code.",
    href: "/guides/patterns/",
  },
  {
    title: "SDK reference",
    note: "createGambi, createClient, and the harness channel.",
    href: "/reference/sdk/",
  },
];
---

<section class="code" aria-labelledby="code-title">
  <div class="code-copy">
    <h2 id="code-title" class="section-title">In your code</h2>
    <p class="section-lead">
      Models answer on an OpenAI-compatible endpoint, so the AI SDK or any
      OpenAI client works. Agents are reached by attaching to the person who
      shared them.
    </p>
    <ul class="doc-links">
      {links.map((l) => (
        <li>
          <a href={l.href}>
            <span class="dl-title">{l.title}</span>
            <span class="dl-note">{l.note}</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l5 5-5 5"></path></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="code-tabs" data-code-tabs>
    <div class="ct-bar" role="tablist" aria-label="Code examples">
      <button role="tab" type="button" id="ct-tab-models" aria-controls="ct-models" aria-selected="true" data-ct="models">Models</button>
      <button role="tab" type="button" id="ct-tab-agents" aria-controls="ct-agents" aria-selected="false" tabindex="-1" data-ct="agents">Agents</button>
    </div>
    <div role="tabpanel" id="ct-models" aria-labelledby="ct-tab-models">
      <Code class="ct-code" code={modelSnippet} lang="ts" theme="css-variables" />
    </div>
    <div role="tabpanel" id="ct-agents" aria-labelledby="ct-tab-agents" hidden>
      <Code class="ct-code" code={agentSnippet} lang="ts" theme="css-variables" />
    </div>
  </div>
</section>

<style>
  .code {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .doc-links {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    border-top: 1px solid var(--e-line-2);
  }

  .doc-links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--e-line);
    text-decoration: none;
    color: var(--e-ink);
  }

  .dl-title {
    font-weight: 650;
    font-variation-settings: "wdth" 104;
  }

  .dl-note {
    grid-column: 1;
    font-size: 0.92rem;
    color: var(--e-ink-3);
  }

  .doc-links svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: var(--e-ink-3);
    stroke-width: 1.8;
    transition: transform 200ms var(--ease-out), stroke 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .doc-links a:hover svg {
      transform: translateX(3px);
      stroke: var(--e-ink);
    }
  }

  .code-tabs {
    border-radius: 14px;
    overflow: hidden;
    background: var(--e-code-bg);
    border: 1px solid var(--e-line);
  }

  .ct-bar {
    display: flex;
    gap: 0.2rem;
    padding: 0.4rem 0.5rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .ct-bar button {
    border: 0;
    background: transparent;
    padding: 0.55rem 0.8rem;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--e-code-dim);
    cursor: pointer;
    box-shadow: inset 0 -2px 0 transparent;
    transition: color 160ms ease, box-shadow 200ms var(--ease-out);
  }

  .ct-bar button[aria-selected="true"] {
    color: var(--e-code-ink);
    box-shadow: inset 0 -2px 0 #f2cf3a;
  }

  [role="tabpanel"][hidden] {
    display: none;
  }

  .code-tabs :global(.ct-code) {
    margin: 0 !important;
    padding: 1.1rem 1.2rem !important;
    font-family: var(--e-mono) !important;
    font-size: 0.86rem !important;
    line-height: 1.65 !important;
    background: var(--e-code-bg) !important;
    border: 0 !important;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #56626f transparent;
  }

  @media (max-width: 56rem) {
    .code {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 44rem) {
    .code-tabs :global(.ct-code) {
      white-space: pre-wrap !important;
      word-break: break-word;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-code-tabs]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.ct === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t.dataset.ct ?? ""));
      t.addEventListener("keydown", (ev) => {
        const delta = ev.key === "ArrowRight" ? 1 : ev.key === "ArrowLeft" ? -1 : 0;
        if (!delta) return;
        ev.preventDefault();
        select(tabs[(i + delta + tabs.length) % tabs.length].dataset.ct ?? "", true);
      });
    });
  }
</script>
