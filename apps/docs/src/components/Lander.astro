  }

  .steps > li {
    position: relative;
    display: grid;
    gap: 0.7rem;
    padding-left: 3.6rem;
    counter-increment: step;
  }

  .steps > li::before {
    content: counter(step);
    position: absolute;
    top: -0.2rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--f-ovo);
    color: var(--f-ovo-ink);
    font-family: var(--f-display);
    font-size: 1.05rem;
  }

  .step-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .install-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cmd-small code {
    font-size: 0.82rem;
