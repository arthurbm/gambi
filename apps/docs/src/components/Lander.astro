    max-width: var(--measure);
    margin: 0 auto;
    padding: 3rem var(--gutter) 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-mark {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    font-variation-settings: "wdth" 118;
  }

  .footer-tag {
    margin: 0.5rem 0 0;
    max-width: 30ch;
    color: var(--e-ink-2);
    font-size: 0.95rem;
  }

  .footer-col {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    font-size: 0.95rem;
  }

  .footer-col a {
    color: var(--e-ink-2);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--e-ink);
  }

  .footer-label {
    margin: 0 0 0.3rem;
    font-size: 0.74rem;
    font-weight: 700;
    font-variation-settings: "wdth" 80;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--e-ink-3);
  }

  .footer-strip {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.2rem var(--gutter) 2rem;
