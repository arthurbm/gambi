  /* --------------------------------------------------------------------
     Setup
     -------------------------------------------------------------------- */

  .steps {
    display: grid;
    gap: 1.75rem;
    max-width: 52rem;
    margin-top: 2.25rem;
    padding: 0;
    list-style: none;
