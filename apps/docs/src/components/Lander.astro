  .footer-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    max-width: var(--measure);
    margin-inline: auto;
    padding: 1rem var(--pad) 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
