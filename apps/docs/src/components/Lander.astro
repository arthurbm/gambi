  }

  /* --------------------------------------------------------------------
     Responsive
     -------------------------------------------------------------------- */

  @media (max-width: 68rem) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* Narrow screens: the beam becomes a rail on the left, cords run sideways. */
  @media (max-width: 56rem) {
    .aisle {
      --cord: 1.6rem;
      position: relative;
    }

    .stalls {
      grid-template-columns: 1fr;
      margin-top: 0;
      padding-top: 0.75rem;
      padding-left: 0.85rem;
      border-left: 6px solid var(--f-lona);
      border-radius: 0 0 0 6px;
    }

    .stall-slot {
      padding-top: 0;
      padding-left: var(--cord);
      margin-bottom: 0.5rem;
    }

    .stall-slot .cord {
      display: block;
      top: 50%;
      left: 0;
      width: var(--cord);
      height: 4px;
      margin: -2px 0 0;
      transform-origin: 100% 50%;
      animation-name: cord-rise-x;
    }

    .cord::before {
      top: 50%;
      left: -2px;
      width: 8px;
      height: 14px;
      margin: -7px 0 0;
      border-radius: 0 3px 3px 0;
    }

    .token {
      top: 50%;
      left: 0;
      margin: -6px 0 0;
    }

    .stall-slot.is-dispatching .token {
      animation-name: token-right;
    }

    .stall {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 0.15rem 0.75rem;
      padding: 1.25rem 1rem 0.85rem;
      border: 0;
      border-radius: 8px;
    }

    .stall-offer {
      justify-self: end;
    }

    .stall-state {
      padding-top: 0.2rem;
      justify-self: end;
    }

  }

  @media (max-width: 44rem) {
    .detail-cols,
    .boards,
    .snippets,
    .cardapio ul {
      grid-template-columns: 1fr;
    }

    .stall-detail {
      margin-top: 0.5rem;
      border-radius: 10px;
    }

    .till {
      flex-wrap: wrap;
      width: 100%;
    }

    .till .cmd {
      width: 100%;
    }

    .till .cmd code,
    .cmd-small code {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .cmd-small {
      max-width: 100%;
    }

    .price-list > div {
      flex-direction: column;
      gap: 0.1rem;
    }

    .price-list dd {
      justify-content: flex-start;
      text-align: left;
    }

    .price-list dd::before {
      content: none;
    }

    /* The ledger reads as labelled entries instead of a sideways scroll. */
    .ledger table,
    .ledger tbody,
    .ledger tr,
    .ledger td {
      display: block;
      width: auto;
      min-width: 0;
    }

    .ledger thead {
      display: none;
    }

    .ledger tr {
      padding: 0.4rem 0;
      border-bottom: 3px double var(--f-rule);
    }

    .ledger tr:last-child {
      border-bottom: 0;
    }

    .ledger td,
    .ledger tr:last-child td {
      padding: 0.6rem 1.1rem;
      border: 0;
    }

    .ledger td:first-child {
      border-right: 0;
    }

    .ledger td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.2rem;
      font-family: var(--f-display);
      font-size: 0.8rem;
    }

    .ledger td:first-child::before {
      color: var(--f-line-harness);
    }

    .ledger td:last-child::before {
      color: var(--f-folha);
    }

    .actions .btn {
      flex: 1 1 auto;
    }

    .hide-sm {
      display: none;
    }

    .steps > li {
      padding-left: 2.75rem;
    }

    .steps > li::before {
      top: -0.1rem;
      width: 2rem;
      height: 2rem;
      font-size: 0.9rem;
    }

    .layer {
      grid-template-columns: 1fr;
    }

    .join code,
    .step-code code,
    .snippet-code code {
      font-size: 0.78rem;
    }

    /* Phones wrap code instead of cutting tokens; wrapped lines hang under their start. */
    .join,
    .step-code,
    .snippet-code {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .join :global(.line),
    .step-code :global(.line),
    .snippet-code :global(.line) {
      display: inline-block;
      padding-left: 2ch;
      text-indent: -2ch;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @keyframes cord-rise-x {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes token-right {
    0% {
      opacity: 1;
      transform: translateX(0);
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(calc(var(--cord) - 12px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cord,
    .stall-slot .cord {
      animation: none;
    }

    .stall-slot.is-dispatching .token {
      animation: none;
    }

    .btn,
    .btn-paint:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>(
    ".feira button.cmd"
  );
  for (const button of copyButtons) {
    button.addEventListener("click", async () => {
      const command = button.dataset.command;
      if (!command) {
        return;
      }
      const status = button.querySelector(".copy-status");
      try {
        await navigator.clipboard.writeText(command);
        button.classList.add("success");
        if (status) {
          status.textContent = "Copied";
        }
      } catch {
        if (status) {
          status.textContent = "Copy failed. Select the command and copy it.";
        }
      }
      setTimeout(() => {
        button.classList.remove("success");
        if (status) {
          status.textContent = "";
        }
      }, 1600);
    });
  }

  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  toggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("starlight-theme", next);
  });

  const stallButtons = document.querySelectorAll<HTMLButtonElement>(
    ".feira .stall"
  );
  const details = document.querySelectorAll<HTMLElement>(
    ".feira [data-detail]"
  );

  function dispatchTo(button: HTMLButtonElement) {
    const slot = button.closest(".stall-slot");
    if (!slot) {
      return;
    }
    slot.classList.remove("is-dispatching");
    // Restart the token's run down this stall's cord.
    void (slot as HTMLElement).offsetWidth;
    slot.classList.add("is-dispatching");
  }

  for (const button of stallButtons) {
    button.addEventListener("click", () => {
      for (const other of stallButtons) {
        other.setAttribute("aria-pressed", String(other === button));
      }
      for (const detail of details) {
        detail.hidden = detail.dataset.detail !== button.dataset.stall;
      }
      dispatchTo(button);
    });
  }

  // Once every cord has reached the beam, the hub sends one job down the first.
  const first = stallButtons[0];
  if (first && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setTimeout(() => dispatchTo(first), 1150 + stallButtons.length * 95);
  }
</script>
