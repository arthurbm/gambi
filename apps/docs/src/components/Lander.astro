---
import CheckIcon from "../assets/lander/check.svg";
import CopyIcon from "../assets/lander/copy.svg";
import CodeSection from "./lander/CodeSection.astro";
import Compare from "./lander/Compare.astro";
import Display from "./lander/Display.astro";
import Examples from "./lander/Examples.astro";
import Wiring from "./lander/Wiring.astro";
import { setupPrompt } from "../prompts";

const install = "curl -fsSL https://gambi.sh/install | bash";

// Evaluated once at build time (SSG): shows the deploy date.
const deployDate = new Date().toISOString().slice(0, 10);

// UI strings come from src/content/i18n/*.json under the `landing.` prefix.
const { t } = Astro.locals;
const { locale } = Astro.locals.starlightRoute;
// Internal links stay inside the visitor's locale ("/x/" -> "/pt-br/x/").
const href = (path: string) => (locale ? `/${locale}${path}` : path);
// The language switch points at the same landing in the other locale.
const other = locale
  ? { href: "/", lang: "en" }
  : { href: "/pt-br/", lang: "pt-BR" };
---

<script is:inline>
  document.documentElement.classList.add("ed-js");
  // Restore the visitor's pause choice before any figure starts moving.
  try {
    if (localStorage.getItem("gambi-motion") === "paused") {
      document.documentElement.dataset.motion = "paused";
    }
  } catch {
    // Storage blocked: figures move until paused on this page.
  }
</script>

<div class="ed">
  <header class="ed-nav">
    <nav class="ed-nav-bar" aria-label="Gambi">
      <a class="ed-mark" href={href("/")} aria-label={t("landing.nav.home")}>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="ed-mark-glyph">
          <circle cx="12" cy="12" r="10.5"></circle>
          <circle cx="12" cy="12" r="2.6"></circle>
          <path d="M3.6 7.4Q8 9 10 11M20.4 7.4Q16 9 14 11M12 22V14.6"></path>
        </svg>
        Gambi
      </a>
      <ul class="ed-links">
        <li><a href={href("/start/introduction/")}>{t("landing.nav.docs")}</a></li>
        <li class="hide-sm"><a href={href("/guides/patterns/")}>{t("landing.nav.patterns")}</a></li>
        <li class="hide-sm"><a href={href("/reference/sdk/")}>{t("landing.nav.sdk")}</a></li>
        <li><a href="https://github.com/arthurbm/gambi" rel="noopener">{t("landing.nav.github")}</a></li>
        <li>
          <a class="lang-switch" href={other.href} hreflang={other.lang} lang={other.lang} aria-label={t("landing.nav.lang.aria")}>{t("landing.nav.lang.label")}</a>
        </li>
        <li class="motion-item">
          <button class="nav-icon motion-toggle" type="button" aria-pressed="false" aria-label={t("landing.nav.pause")} title={t("landing.nav.pause")} data-label-pause={t("landing.nav.pause")} data-label-play={t("landing.nav.play")}>
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 6.5v11M15 6.5v11"></path>
            </svg>
            <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8.5 6.2v11.6L18 12Z"></path>
            </svg>
          </button>
        </li>
        <li>
          <button class="nav-icon theme-toggle" type="button" aria-label={t("landing.nav.theme")} title={t("landing.nav.theme")}>
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2"></circle>
              <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"></path>
            </svg>
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </header>

  <main class="ed-main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-title">
          <span class="ht-one">{t("landing.hero.one")}</span>
          <span class="ht-many">{t("landing.hero.many")}</span>
        </h1>
        <p class="lede">{t("landing.hero.lede")}</p>
        <dl class="brings">
          <div class="bring bring-harness">
            <dt>{t("landing.hero.agents")}</dt>
            <dd>Claude Code, Codex, OpenCode</dd>
          </div>
          <div class="bring bring-model">
            <dt>{t("landing.hero.models")}</dt>
            <dd>Ollama, vLLM, <span class="bring-more">{t("landing.hero.modelsMore")}</span></dd>
          </div>
          <div class="bring bring-stop">
            <dt>{t("landing.hero.stays")}</dt>
            <dd>{t("landing.hero.staysWhat")}</dd>
          </div>
        </dl>
        <div class="actions">
          <button class="cmd" type="button" data-command={install} data-copied={t("landing.cmd.copied")} data-failed={t("landing.cmd.failed")} aria-label={t("landing.cmd.aria")}>
            <span class="cmd-prompt" aria-hidden="true">$</span>
            <code>{install}</code>
            <span class="copy-icon" aria-hidden="true"><CopyIcon /><CheckIcon /></span>
            <span class="sr-only copy-status" aria-live="polite"></span>
          </button>
          <div class="action-row">
            <a class="btn btn-primary" href={href("/start/quickstart/")}>{t("landing.hero.getStarted")}</a>
            <a class="btn-text" href="#how">
              {t("landing.hero.how")}
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5"></path></svg>
            </a>
          </div>
        </div>
      </div>
      <Display />
    </section>

    <Compare />
    <Wiring />
    <Examples />
    <CodeSection />

    <section class="start" aria-labelledby="start-title">
      <h2 id="start-title" class="section-title">{t("landing.start.title")}</h2>
      <p class="section-lead">{t("landing.start.lead")}</p>
      <div class="start-actions">
        <button class="cmd" type="button" data-command={install} data-copied={t("landing.cmd.copied")} data-failed={t("landing.cmd.failed")} aria-label={t("landing.cmd.aria")}>
          <span class="cmd-prompt" aria-hidden="true">$</span>
          <code>{install}</code>
          <span class="copy-icon" aria-hidden="true"><CopyIcon /><CheckIcon /></span>
          <span class="sr-only copy-status" aria-live="polite"></span>
        </button>
        <a class="btn btn-primary" href={href("/start/quickstart/")}>{t("landing.start.quickstart")}</a>
      </div>
      <p class="start-agent">
        <button class="prompt-copy" type="button" data-prompt={setupPrompt(locale)} data-copied={t("landing.start.promptCopied")} data-failed={t("landing.start.promptFailed")}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6.5h16M4 12h10M4 17.5h7"></path>
            <path d="m15.5 15 2.5 2.5-2.5 2.5"></path>
          </svg>
          <span class="prompt-copy-label">{t("landing.start.prompt")}</span>
        </button>
        <span class="start-agent-note">{t("landing.start.promptNote")}</span>
        <span class="sr-only prompt-status" aria-live="polite"></span>
      </p>
    </section>
  </main>

  <footer class="ed-footer">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-mark">Gambi</p>
        <p class="footer-tag">{t("landing.footer.tag")}</p>
      </div>
      <nav class="footer-col" aria-label={t("landing.footer.guides")}>
        <p class="footer-label">{t("landing.footer.guides")}</p>
        <a href={href("/start/quickstart/")}>{t("landing.footer.quickstart")}</a>
        <a href={href("/guides/bring-your-harness/")}>{t("landing.footer.bringAgent")}</a>
        <a href={href("/guides/patterns/")}>{t("landing.footer.patterns")}</a>
        <a href={href("/guides/remote-providers/")}>{t("landing.footer.remote")}</a>
      </nav>
      <nav class="footer-col" aria-label={t("landing.footer.reference")}>
        <p class="footer-label">{t("landing.footer.reference")}</p>
        <a href={href("/reference/cli/")}>{t("landing.footer.cli")}</a>
        <a href={href("/reference/sdk/")}>{t("landing.footer.sdk")}</a>
        <a href={href("/reference/api/")}>{t("landing.footer.api")}</a>
        <a href={href("/reference/observability/")}>{t("landing.footer.observability")}</a>
      </nav>
      <nav class="footer-col" aria-label={t("landing.footer.project")}>
        <p class="footer-label">{t("landing.footer.project")}</p>
        <a href={href("/concepts/tunnel-first/")}>{t("landing.footer.tunnels")}</a>
        <a href={href("/concepts/whats-next/")}>{t("landing.footer.next")}</a>
        <a href={href("/concepts/why-gambi/")}>{t("landing.footer.why")}</a>
        <a href="https://github.com/arthurbm/gambi" rel="noopener">{t("landing.nav.github")}</a>
      </nav>
    </div>
    <div class="footer-strip">
      <span>{t("landing.footer.short")}</span>
      <span>{t("landing.footer.built", { date: deployDate })}</span>
    </div>
  </footer>
</div>

<style is:global>
  /* Tokens and fonts come from src/styles/tokens.css (Starlight customCss). */
  :root[data-has-hero] {
    background: var(--e-ground);
  }

  :root[data-has-hero] body {
    background: var(--e-ground);
    color: var(--e-ink);
    font-family: var(--e-text);
  }

  :root[data-has-hero] .main-pane .content-panel {
    padding: 0 !important;
    border: 0;
  }

  :root[data-has-hero] .main-pane .content-panel > .sl-container {
    max-width: none;
  }

  :root[data-has-hero] .main-pane .sl-markdown-content {
    display: none;
  }

  /* The landing draws its own nav; drop Starlight's chrome on this route. */
  :root[data-has-hero] header.header {
    display: none;
  }

  :root[data-has-hero] .main-frame {
    padding-top: 0;
  }

  :root[data-has-hero] .main-pane > main {
    padding: 0 !important;
  }

  /* Shared by every landing section component. */

  .ed {
    --gutter: clamp(1rem, 4vw, 3.5rem);
    --measure: 84rem;
    font-family: var(--e-text);
    font-variation-settings: "wdth" 100;
    color: var(--e-ink);
    background: var(--e-ground);
    font-size: 1.0625rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    scrollbar-color: var(--e-steel) transparent;
  }

  .ed a {
    color: inherit;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }

  .ed code {
    font-family: var(--e-mono);
    font-size: 0.86em;
    font-variant-ligatures: none;
  }

  .ed :is(p, li, dd, td) > code {
    padding: 0.08em 0.32em;
    border-radius: 4px;
    background: var(--e-panel);
    border: 1px solid var(--e-line);
    white-space: nowrap;
  }

  .ed .readout-id code,
  .ed .log code {
    padding: 0;
    background: none;
    border: 0;
  }

  .ed :focus-visible {
    outline: 2px solid var(--e-harness);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .ed .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ed-main > section {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(4.5rem, 10vw, 8rem) var(--gutter) 0;
    scroll-margin-top: 1rem;
  }

  .ed .section-title {
    margin: 0;
    max-width: 20ch;
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    line-height: 1.04;
    font-weight: 650;
    font-variation-settings: "wdth" 116;
    letter-spacing: -0.025em;
    text-wrap: balance;
    color: var(--e-ink);
  }

  .ed .section-lead {
    margin: 1.1rem 0 0;
    max-width: 62ch;
    font-size: clamp(1.06rem, 1.3vw, 1.2rem);
    color: var(--e-ink-2);
    text-wrap: pretty;
  }

  .ed .btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0 1.3rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms var(--ease-out);
  }

  .ed .btn:active {
    transform: scale(0.97);
  }

  .ed .btn-primary {
    background: var(--e-primary);
    color: var(--e-primary-ink);
  }

  .ed .btn-primary:hover {
    background: color-mix(in oklab, var(--e-primary) 86%, var(--e-ink-3));
  }

  .ed .cmd {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--e-line-2);
    background: var(--e-sheet);
    color: var(--e-ink);
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition: border-color 160ms ease, transform 160ms var(--ease-out);
  }

  .ed .cmd:hover {
    border-color: var(--e-ink-3);
  }

  .ed .cmd:active {
    transform: scale(0.98);
  }

  .ed .cmd code {
    min-width: 0;
    flex: 1 1 auto;
    font-size: 0.92rem;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .ed .cmd-prompt {
    font-family: var(--e-mono);
    font-size: 0.92rem;
    color: var(--e-ink-3);
  }

  .ed .copy-icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--e-ink-3);
  }

  .ed .copy-icon svg {
    position: absolute;
    inset: 0;
    width: 1rem;
    height: 1rem;
    transition: opacity 180ms ease, transform 180ms var(--ease-out);
  }

  .ed .copy-icon svg:last-child {
    opacity: 0;
    transform: scale(0.8);
    color: var(--e-harness);
  }

  .ed .cmd.success .copy-icon svg:first-child {
    opacity: 0;
    transform: scale(0.8);
  }

  .ed .cmd.success .copy-icon svg:last-child {
    opacity: 1;
    transform: scale(1);
  }

  /* The headline swaps emphasis with the hero display's mode. */
  .ed .ht-one,
  .ed .ht-many {
    transition: color 600ms var(--ease-out);
  }

  .ed .hero:has(.display[data-mode="one"]) .ht-one {
    color: var(--e-ink);
  }

  .ed .hero:has(.display[data-mode="one"]) .ht-many {
    color: var(--e-ink-3);
  }
</style>

<style>
  /* ---------- nav ---------- */

  .ed-nav {
    border-bottom: 1px solid var(--e-line);
  }

  .ed-nav-bar {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0.85rem var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .ed-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    font-size: 1.15rem;
    font-variation-settings: "wdth" 118;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .ed-mark-glyph {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .ed-mark-glyph circle:nth-child(2) {
    fill: var(--e-model-strong);
    stroke: none;
  }

  .ed-links {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .ed-links a {
    color: var(--e-ink-2);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .ed-links a:hover {
    color: var(--e-ink);
  }

  .nav-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    border: 1px solid var(--e-line-2);
    background: transparent;
    color: var(--e-ink-2);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .nav-icon:hover {
    color: var(--e-ink);
    border-color: var(--e-ink-3);
  }

  .nav-icon svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .i-moon,
  .i-play {
    display: none;
  }

  .motion-toggle svg {
    stroke-linejoin: round;
  }

  .motion-toggle[aria-pressed="true"] .i-pause {
    display: none;
  }

  .motion-toggle[aria-pressed="true"] .i-play {
    display: block;
  }

  /* Nothing moves under reduced motion, so there is nothing to pause. */
  @media (prefers-reduced-motion: reduce) {
    .motion-item {
      display: none;
    }
  }

  :global(:root[data-theme="dark"]) .i-sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .i-moon {
    display: block;
  }

  /* ---------- hero ---------- */

  .ed-main > .hero {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
    min-height: min(calc(100svh - 4.5rem), 58rem);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.3rem, 3.7vw, 3.75rem);
    line-height: 1.02;
    font-weight: 680;
    font-variation-settings: "wdth" 108;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-title span {
    display: block;
  }

  .ht-one {
    color: var(--e-ink-3);
  }

  .ht-many {
    margin-top: 0.12em;
    color: var(--e-ink);
  }

  .lede {
    margin: 1.6rem 0 0;
    max-width: 52ch;
    font-size: clamp(1.08rem, 1.35vw, 1.24rem);
    line-height: 1.55;
    color: var(--e-ink-2);
    text-wrap: pretty;
  }

  /* What each person brings, keyed by the display's track colors. */
  .brings {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1.4rem;
    border-top: 1px solid var(--e-line-2);
  }

  .bring {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--e-line);
  }

  .bring dt {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.74rem;
    font-weight: 700;
    font-variation-settings: "wdth" 80;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--e-ink-3);
  }

  .bring dt::before {
    content: "";
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
  }

  .bring-harness dt::before {
    background: var(--e-harness);
  }

  .bring-model dt::before {
    background: var(--e-model);
  }

  .bring-stop dt::before {
    border-radius: 2px;
    background: var(--e-stop);
  }

  .bring dd {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--e-ink);
  }

  .bring-more {
    font-weight: 400;
    color: var(--e-ink-2);
  }

  .actions {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    justify-items: start;
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
  }

  .btn-text {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--e-ink-2);
    transition: color 160ms ease;
  }

  .btn-text svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform 200ms var(--ease-out);
  }

  .btn-text:hover {
    color: var(--e-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-text:hover svg {
      transform: translateY(2px);
    }
  }

  /* ---------- start ---------- */

  .start-actions {
    margin-top: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  .start-agent {
    margin: 1.4rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    color: var(--e-ink-3);
    font-size: 0.95rem;
  }

  .prompt-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--e-ink);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--e-line-2);
    text-underline-offset: 0.22em;
    cursor: pointer;
    transition: text-decoration-color 160ms ease;
  }

  .prompt-copy:hover {
    text-decoration-color: currentColor;
  }

  .prompt-copy svg {
    flex: none;
    align-self: center;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: var(--e-harness);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .prompt-copy.success .prompt-copy-label {
    color: var(--e-harness);
  }

  /* ---------- footer ---------- */

  .ed-footer {
