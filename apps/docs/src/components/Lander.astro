  .cardapio-title {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--f-ovo);
  }

  .cardapio ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 3rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .cardapio a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.65rem 0;
