</style>

<script>
  import { isPaused, setPaused } from "./lander/motion";

  const motionToggle = document.querySelector<HTMLButtonElement>(".ed .motion-toggle");
  const syncMotionToggle = () => {
    if (!motionToggle) return;
    const paused = isPaused();
    motionToggle.setAttribute("aria-pressed", String(paused));
    const label = (paused ? motionToggle.dataset.labelPlay : motionToggle.dataset.labelPause) ?? "";
    motionToggle.setAttribute("aria-label", label);
    motionToggle.title = label;
  };
  syncMotionToggle();
  motionToggle?.addEventListener("click", () => {
    setPaused(!isPaused());
    syncMotionToggle();
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>(".ed button.cmd")) {
    button.addEventListener("click", async () => {
      const command = button.dataset.command;
      if (!command) return;
      const status = button.querySelector(".copy-status");
      try {
        await navigator.clipboard.writeText(command);
        button.classList.add("success");
        if (status) status.textContent = button.dataset.copied ?? "";
      } catch {
        if (status) status.textContent = button.dataset.failed ?? "";
      }
      setTimeout(() => {
        button.classList.remove("success");
        if (status) status.textContent = "";
      }, 1600);
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".ed .prompt-copy")) {
    const label = button.querySelector(".prompt-copy-label");
    const status = button.parentElement?.querySelector(".prompt-status");
    const idle = label?.textContent ?? "";
    button.addEventListener("click", async () => {
      const prompt = button.dataset.prompt;
      if (!(prompt && label)) return;
      try {
        await navigator.clipboard.writeText(prompt);
        button.classList.add("success");
        label.textContent = button.dataset.copied ?? idle;
        if (status) status.textContent = button.dataset.copied ?? "";
      } catch {
        if (status) status.textContent = button.dataset.failed ?? "";
      }
      setTimeout(() => {
        button.classList.remove("success");
        label.textContent = idle;
        if (status) status.textContent = "";
      }, 2000);
    });
  }

  document.querySelector<HTMLButtonElement>(".ed .theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("starlight-theme", next);
  });
</script>
