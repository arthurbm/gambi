      2px 2px 0 #fff,
      3px 3px 0 #fff;
  }

  .board-harness .board-title {
    color: #fff;
    text-shadow:
      1px 1px 0 #0a1a40,
      2px 2px 0 #0a1a40,
      3px 3px 0 #0a1a40;
  }

  .board-what {
    max-width: 44ch;
    font-size: 1.05rem;
  }

  .price-list {
    display: grid;
    gap: 0.55rem;
  }

  .price-list > div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .price-list dt {
    flex: none;
    font-weight: 700;
    font-stretch: 90%;
  }

  /* Dotted leaders, the way a price board runs a line to the price. */
  .price-list dd {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-align: right;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .price-list dd::before {
    content: "";
    flex: 1 1 1.5rem;
    min-width: 1.5rem;
    border-bottom: 2px dotted currentColor;
    opacity: 0.55;
    transform: translateY(-0.25em);
  }

  .board code {
    font-size: 0.84rem;
    font-weight: 600;
  }

  .board-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.4rem;
    font-weight: 700;
    text-decoration-thickness: 2px !important;
  }

  .board-link::after {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-left: 0.45em;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg) translateY(-0.08em);
    transition: transform 160ms var(--f-ease);
  }

  .board-link:hover::after {
    transform: translateX(3px) rotate(45deg) translateY(-0.08em);
  }

  .menu-note {
    max-width: 62ch;
    margin-top: 1.25rem;
    color: var(--f-ink-soft);
  }

  /* --------------------------------------------------------------------
     Ledger: a ruled account book
     -------------------------------------------------------------------- */

  .ledger-book {
    margin-top: 2.25rem;
    overflow-x: auto;
    border-radius: 12px;
    background: var(--f-board);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.45);
  }

  .ledger table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
  }

  .ledger th {
    padding: 1rem 1.4rem 0.85rem;
    border-bottom: 3px double var(--f-ink);
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 400;
    text-align: left;
  }

  .ledger th:first-child {
    color: var(--f-line-harness);
  }

  .ledger th:last-child {
    color: var(--f-folha);
  }

  .ledger td {
    width: 50%;
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--f-rule);
    vertical-align: top;
  }

  .ledger td:first-child {
    border-right: 1px solid var(--f-rule);
  }

  .ledger tr:last-child td {
    border-bottom: 0;
  }

  .aviso {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    padding: 1.1rem 1.4rem;
    border: 2px solid var(--f-alarm);
    border-radius: 12px;
    outline: 1px solid var(--f-alarm);
    outline-offset: -7px;
  }

  .aviso-title {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--f-alarm);
  }

  .aviso p {
    flex: 1 1 30rem;
    max-width: 75ch;
  }

  .aviso a {
    font-weight: 700;
    white-space: nowrap;
  }

  /* --------------------------------------------------------------------
     Build on it
     -------------------------------------------------------------------- */

  .snippets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    margin-top: 2.25rem;
  }

  .snippet {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .snippet figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
