---
import "@fontsource/bungee/400.css";
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import { Code } from "astro:components";
import CheckIcon from "../assets/lander/check.svg";
import CopyIcon from "../assets/lander/copy.svg";

const install = {
  curl: "curl -fsSL https://gambi.sh/install | bash",
  npm: "npm install -g gambi",
  bun: "bun add -g gambi",
};

interface Stall {
  id: string;
  name: string;
  kind: "model" | "harness";
  offer: string;
  via: string;
  join: string;
  down: [string, string][];
  stays: string[];
}

// Example room. Names, models, and addresses are illustrative; every command,
// flag, and frame type is the real one from packages/cli and packages/core.
const stalls: Stall[] = [
  {
    id: "arthur-ollama",
    name: "Arthur",
    kind: "model",
    offer: "llama3",
    via: "Ollama on localhost:11434",
    join: `gambi participant join \\
  --room ABC123 \\
  --participant-id arthur-ollama \\
  --name Arthur \\
  --model llama3 \\
  --endpoint http://localhost:11434`,
    down: [
      [
        "tunnel.request",
        "An OpenAI-compatible call for llama3, replayed against localhost.",
      ],
      [
        "tunnel.response.chunk",
        "The streamed answer goes back up the same socket.",
      ],
    ],
    stays: [
      "Ollama keeps listening on loopback. The hub never calls it.",
      "No provider key exists, so none is sent.",
    ],
  },
  {
    id: "bia-claude",
    name: "Bia",
    kind: "harness",
    offer: "claude-code",
    via: "Claude Code through claude-agent-acp",
    join: `gambi participant join \\
  --room ABC123 \\
  --participant-id bia-claude \\
  --name Bia \\
  --harness claude-code`,
    down: [
      [
        "tunnel.harness.message",
        "ACP v1 JSON-RPC. The hub relays it without reading it.",
      ],
      [
        "tunnel.harness.artifact",
        "Changed workspace files, sent back up as a versioned snapshot.",
      ],
    ],
    stays: [
      "Her Claude login. The CLI checks it locally before joining.",
      "The harness itself, running in ~/.gambi/workspaces/ABC123/bia-claude/.",
    ],
  },
  {
    id: "lu-vllm",
    name: "Lu",
    kind: "model",
    offer: "qwen2.5-coder",
    via: "vLLM on 127.0.0.1:8000",
    join: `gambi participant join \\
  --room ABC123 \\
  --participant-id lu-vllm \\
  --name Lu \\
  --model qwen2.5-coder \\
  --endpoint http://127.0.0.1:8000 \\
  --header-env Authorization=VLLM_AUTH`,
    down: [
      [
        "tunnel.request",
        "Routed here when an app asks for model:qwen2.5-coder.",
      ],
      [
        "tunnel.response.end",
        "Closes the stream, with timing for the room's events.",
      ],
    ],
    stays: [
      "The Authorization header from VLLM_AUTH. It is added only to the local call.",
      "vLLM's port, which nobody outside this laptop has to reach.",
    ],
  },
  {
    id: "caio-codex",
    name: "Caio",
    kind: "harness",
    offer: "codex",
    via: "Codex CLI through codex-acp",
    join: `gambi participant join \\
  --room ABC123 \\
  --participant-id caio-codex \\
  --name Caio \\
  --harness codex \\
  --workspace ./my-project`,
    down: [
      [
        "tunnel.harness.control",
        "Opens or closes a harness session for the attached app.",
      ],
      [
        "tunnel.harness.status",
        "Reports opened, closed, or error back to that app.",
      ],
    ],
    stays: [
      "His Codex login, verified with codex login status.",
      "./my-project, the checkout he chose. The hub cannot write files into it.",
    ],
  },
  {
    id: "tati-openrouter",
    name: "Tati",
    kind: "model",
    offer: "llama-3.3-70b",
    via: "OpenRouter, called from Tati's laptop",
    join: `gambi participant join \\
  --room ABC123 \\
  --participant-id tati-openrouter \\
  --name Tati \\
  --model meta-llama/llama-3.3-70b-instruct \\
  --endpoint https://openrouter.ai/api \\
  --header-env Authorization=OPENROUTER_AUTH`,
    down: [
      [
        "tunnel.request",
        "Forwarded by her runtime to OpenRouter with her key attached.",
      ],
      [
        "tunnel.response.chunk",
        "Tokens stream back through her tunnel, not around it.",
      ],
    ],
    stays: [
      "Her OpenRouter key, read from OPENROUTER_AUTH. It goes only to OpenRouter.",
      "The bill. Each person pays for what their own stall serves.",
    ],
  },
  {
    id: "duda-opencode",
    name: "Duda",
    kind: "harness",
    offer: "opencode",
    via: "opencode acp",
    join: `gambi participant join \\
  --room ABC123 \\
  --participant-id duda-opencode \\
  --name Duda \\
  --harness opencode`,
    down: [
      [
        "tunnel.harness.message",
        "Prompts and tool updates for one ACP session.",
      ],
      [
        "tunnel.harness.artifact",
        "Workspace files, minus .git and node_modules.",
      ],
    ],
    stays: [
      "The provider credentials OpenCode already has configured.",
      "Ctrl+C closes the harness and leaves the room in one go.",
    ],
  },
];

const patterns = [
  { title: "Model arena", href: "/guides/patterns/#model-arena" },
  { title: "Jury panel", href: "/guides/patterns/#jury-panel" },
  {
    title: "Draft, critique, polish",
    href: "/guides/patterns/#draft-critique-polish",
  },
  { title: "Debate club", href: "/guides/patterns/#debate-club" },
  {
    title: "Multi-persona NPCs",
    href: "/guides/patterns/#multi-persona-npcs",
  },
  { title: "LAN debate club", href: "/guides/patterns/#lan-debate-club" },
];

const modelSnippet = `import { generateText } from "ai";
import { createGambi } from "gambi-sdk";

const gambi = createGambi({
  roomCode: "ABC123",
  hubUrl: "http://192.168.1.10:3000",
});

// any model stall in the room
const draft = await generateText({
  model: gambi.any(),
  prompt: "Draft the release note for v0.7.",
});

// or one model, by name
const review = await generateText({
  model: gambi.model("llama3"),
  prompt: \`Tighten this: \${draft.text}\`,
});`;

const harnessSnippet = `import { createClient } from "gambi-sdk";

const client = createClient({
  hubUrl: "http://192.168.1.10:3000",
});

const channel = await client.harness.attach({
  roomCode: "ABC123",
  participantId: "bia-claude",
});

channel.send({
  type: "tunnel.harness.control",
  sessionId: "release-notes",
  action: "open",
});

// ACP v1 JSON-RPC from here on; the hub never parses it
for await (const frame of channel.messages) {
  if (frame.type === "tunnel.harness.artifact") {
    console.log(frame.version, frame.files.map((f) => f.path));
  }
}`;

const firstJoin = `gambi participant join \\
  --room ABC123 \\
  --participant-id arthur-opencode \\
  --name Arthur \\
  --harness opencode`;

// Evaluated once at build time (SSG): shows the deploy date.
const deployDate = new Date().toISOString().slice(0, 10);
---

<div class="feira">
  <header class="canopy">
    <nav class="canopy-bar" aria-label="Gambi">
      <a class="canopy-mark" href="/" aria-label="Gambi home">Gambi</a>
      <ul class="canopy-links">
        <li><a href="/guides/quickstart/">Docs</a></li>
        <li class="hide-sm"><a href="/guides/bring-your-harness/">Harness guide</a></li>
        <li class="hide-sm"><a href="/reference/sdk/">SDK</a></li>
        <li>
          <a href="https://github.com/arthurbm/gambi" rel="noopener">GitHub</a>
        </li>
        <li>
          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch between day and night"
            title="Switch between day and night"
          >
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2"></circle>
              <path
                d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"
              ></path>
            </svg>
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </header>

  <main class="lander-main">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="painted hero-title">
        <span class="line line-model">Bring your model.</span>
        <span class="line line-harness">Bring your harness.</span>
        <span class="line line-keys">Keep your keys.</span>
      </h1>

      <p class="lede">
        Gambi is a local-first hub for a network you trust. Each participant
        dials out to it from its own machine and shares an OpenAI-compatible
        model or a coding harness such as Claude Code, Codex, or OpenCode. The
        hub sends work down that tunnel. It never opens a connection to you.
      </p>

      <div class="actions">
        <div class="till">
          <span class="till-label" id="till-label">Install</span>
          <button
            class="cmd"
            type="button"
            data-command={install.curl}
            aria-describedby="till-label"
          >
            <code>{install.curl}</code>
            <span class="copy-icon" aria-hidden="true">
              <CopyIcon />
              <CheckIcon />
            </span>
            <span class="sr-only copy-status" aria-live="polite"></span>
          </button>
        </div>
        <a class="btn btn-paint" href="/guides/quickstart/">Quick start</a>
        <a class="btn btn-filete" href="/guides/bring-your-harness/"
          >Bring your harness</a
        >
      </div>
    </section>

    <section class="aisle" aria-labelledby="aisle-title">
      <h2 id="aisle-title" class="sr-only">An example room</h2>
      <div class="beam">
        <div class="tarp" aria-hidden="true"></div>
        <div class="beam-plate">
        <span class="beam-name">Gambi hub</span>
        <span class="beam-note">
          Example room <code>ABC123</code>. Six made-up stalls, each plugged
          in from its own laptop. Pick one to see its tunnel.
        </span>
        </div>
        <div class="hem" aria-hidden="true"></div>
      </div>

      <ul class="stalls">
        {
          stalls.map((s, i) => (
            <li class:list={["stall-slot", `kind-${s.kind}`]} style={`--i: ${i}`}>
              <span class="cord" aria-hidden="true">
                <span class="token" />
              </span>
              <button
                class="stall"
                type="button"
                aria-pressed={i === 0 ? "true" : "false"}
                aria-controls="stall-detail"
                data-stall={s.id}
              >
                <span class="stall-roof" aria-hidden="true" />
                <span class="stall-name">{s.name}</span>
                <code class="stall-offer">{s.offer}</code>
                <span class="stall-kind">
                  {s.kind === "model" ? "Model" : "Harness · ACP"}
                </span>
                <span class="stall-state">
                  <span class="lamp" aria-hidden="true" />
                  tunnel open
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      <div class="stall-detail" id="stall-detail" aria-live="polite">
        {
          stalls.map((s, i) => (
            <article
              class="detail"
              data-detail={s.id}
              hidden={i !== 0}
              aria-labelledby={`detail-${s.id}`}
            >
              <header class="detail-head">
                <h3 id={`detail-${s.id}`} class="detail-title">
                  {s.name}'s stall
                </h3>
                <p class="detail-via">{s.via}</p>
              </header>
              <div class="detail-cols">
                <div class="detail-col">
                  <h4 class="detail-sub">Down the tunnel</h4>
                  <dl class="frames">
                    {s.down.map(([frame, note]) => (
                      <div class="frame-row">
                        <dt>
                          <code>{frame}</code>
                        </dt>
                        <dd>{note}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <div class="detail-col">
                  <h4 class="detail-sub">Stays at {s.name}'s stall</h4>
                  <ul class="stays">
                    {s.stays.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <Code class="join" code={s.join} lang="bash" theme="css-variables" />
            </article>
          ))
        }
      </div>
    </section>

    <section class="menu" aria-labelledby="menu-title">
      <h2 id="menu-title" class="painted section-title">
        Two kinds of stall, one canopy
      </h2>
      <p class="section-lead">
        A participant shares either a model endpoint or a harness. Both join
        with the same command and travel through the same kind of tunnel. What
        crosses that tunnel is different.
      </p>

      <div class="boards">
        <article class="board board-model" aria-labelledby="board-model">
          <h3 id="board-model" class="board-title">Models</h3>
          <p class="board-what">
            Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio,
            OpenRouter, or your own server.
          </p>
          <dl class="price-list">
            <div><dt>Serves</dt><dd><code>/responses</code> and <code>/chat/completions</code></dd></div>
            <div><dt>Picked by</dt><dd>participant id, <code>model:&lt;name&gt;</code>, or <code>*</code></dd></div>
            <div><dt>Watched with</dt><dd><code>llm.request</code>, <code>llm.complete</code>, <code>llm.error</code></dd></div>
            <div><dt>Reached by</dt><dd>apps on <code>/rooms/:code/v1</code></dd></div>
          </dl>
          <a class="board-link" href="/guides/quickstart/">Share a model</a>
        </article>

        <article class="board board-harness" aria-labelledby="board-harness">
          <h3 id="board-harness" class="board-title">Harnesses</h3>
          <p class="board-what">
            Claude Code, Codex, or OpenCode, already logged in on your machine,
            speaking ACP v1 through your tunnel.
          </p>
          <dl class="price-list">
            <div><dt>Speaks</dt><dd>ACP v1, relayed opaque</dd></div>
            <div><dt>Works in</dt><dd>a folder you pick with <code>--workspace</code>, or an empty one under <code>~/.gambi/workspaces/</code></dd></div>
            <div><dt>Sends back</dt><dd>versioned workspace artifacts</dd></div>
            <div><dt>Reached by</dt><dd>apps calling <code>client.harness.attach()</code></dd></div>
          </dl>
          <a class="board-link" href="/guides/bring-your-harness/"
            >Bring your harness</a
          >
        </article>
      </div>
      <p class="menu-note">
        Harness participants never take inference calls, and model routing
        never picks them. Apps attach to a harness by participant id.
      </p>
    </section>

    <section class="ledger" aria-labelledby="ledger-title">
      <h2 id="ledger-title" class="painted section-title">
        What crosses the tunnel, and what never leaves your machine
      </h2>

      <div class="ledger-book">
        <table>
          <caption class="sr-only">
            What a participant sends to the hub, and what stays on the
            participant machine
          </caption>
          <thead>
            <tr>
              <th scope="col">Goes to the hub</th>
              <th scope="col">Stays at your stall</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-label="Goes to the hub">Participant id, display name, model name, and a capability summary.</td>
              <td data-label="Stays at your stall">
                Provider auth headers set with <code>--header</code> or
                <code>--header-env</code>. They are added only when your runtime
                calls your provider.
              </td>
            </tr>
            <tr>
              <td data-label="Goes to the hub">The provider URL, as a label. The hub never calls it.</td>
              <td data-label="Stays at your stall">
                The provider itself. It can keep listening on
                <code>localhost</code>.
              </td>
            </tr>
            <tr>
              <td data-label="Goes to the hub">Model responses, streamed back up the tunnel your runtime opened.</td>
              <td data-label="Stays at your stall">
                Your harness login. It is not part of registration, room
                events, or tunnel frames.
              </td>
            </tr>
            <tr>
              <td data-label="Goes to the hub">ACP messages for an attached session, plus the workspace files your harness writes.</td>
              <td data-label="Stays at your stall">
                The harness process, its tools, and everything outside its
                workspace folder. The hub cannot write files into that folder.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <aside class="aviso" aria-labelledby="aviso-title">
        <h3 id="aviso-title" class="aviso-title">Trusted networks only</h3>
        <p>
          The hub has no built-in authentication. Run it on a network where
          you trust everyone, such as your home, your lab, or the room your
          club meets in.
          <a href="/explanation/tunnel-first/">How the tunnel works</a>
        </p>
      </aside>
    </section>

    <section class="build" aria-labelledby="build-title">
      <h2 id="build-title" class="painted section-title">
        Gambi connects them. You write what happens between them.
      </h2>

      <div class="snippets">
        <figure class="snippet">
          <figcaption>
            <span class="snippet-file">app.ts</span>
            <span class="snippet-what">models, through the AI SDK</span>
          </figcaption>
          <Code class="snippet-code" code={modelSnippet} lang="ts" theme="css-variables" />
        </figure>
        <figure class="snippet">
          <figcaption>
            <span class="snippet-file">attach.ts</span>
            <span class="snippet-what">a harness, through the management client</span>
          </figcaption>
          <Code class="snippet-code" code={harnessSnippet} lang="ts" theme="css-variables" />
        </figure>
      </div>

      <div class="cardapio" aria-labelledby="cardapio-title">
        <h3 id="cardapio-title" class="cardapio-title">Recipes on the board</h3>
        <ul>
          {
            patterns.map((p) => (
              <li>
                <a href={p.href}>
                  <span class="dish">{p.title}</span>
                  <span class="leader" aria-hidden="true" />
                  <span class="see">see the pattern</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="layers" aria-labelledby="layers-title">
      <h2 id="layers-title" class="painted section-title">
        What Gambi handles, and what is still yours
      </h2>
      <p class="section-lead">
        Gambi moves work between participants. Who talks when, what context
        they share, and who reviews the result is still your code.
      </p>

      <ol class="layer-stack">
        <li class="layer layer-yours">
          <h3 class="layer-title">What you build</h3>
          <p class="layer-body">
            Arenas, jury panels, debate clubs, games with a model per
            character, a squad of harnesses working one task.
          </p>
        </li>
        <li class="layer layer-above">
          <h3 class="layer-title">
            The layer above <span class="tag tag-sketch">Being explored</span>
          </h3>
          <p class="layer-body">
            Turn-taking, shared context, and orchestration across harnesses.
            Nothing here is promised yet. The club's experiments, such as the
            event board and its orchestrator, live in their own repository,
            <a class="lab" href="https://github.com/arthurbm/gambiarra-lab" rel="noopener">gambiarra-lab</a>.
          </p>
        </li>
        <li class="layer layer-today">
          <h3 class="layer-title">
            Gambi today <span class="tag tag-today">Shipping</span>
          </h3>
          <p class="layer-body">
            One hub. Models and harnesses from many machines, each through a
            tunnel its owner opened, with live events for every request.
          </p>
        </li>
      </ol>
    </section>

    <section class="setup" aria-labelledby="setup-title">
      <h2 id="setup-title" class="painted section-title">
        Put up the canopy
      </h2>
      <ol class="steps">
        <li>
          <h3 class="step-title">Install the CLI on each machine</h3>
          <div class="install-row">
            {
              Object.entries(install).map(([tool, command]) => (
                <button
                  class="cmd cmd-small"
                  type="button"
                  data-command={command}
                  aria-label={`Copy the ${tool} install command`}
                >
                  <code>{command}</code>
                  <span class="copy-icon" aria-hidden="true">
                    <CopyIcon />
                    <CheckIcon />
                  </span>
                  <span class="sr-only copy-status" aria-live="polite" />
                </button>
              ))
            }
          </div>
        </li>
        <li>
          <h3 class="step-title">Start the hub</h3>
          <Code class="step-code" code="gambi hub serve" lang="bash" theme="css-variables" />
        </li>
        <li>
          <h3 class="step-title">Open a room</h3>
          <Code class="step-code" code='gambi room create --name "Demo"' lang="bash" theme="css-variables" />
        </li>
        <li>
          <h3 class="step-title">Join from your own machine</h3>
          <Code
            class="step-code"
            code={firstJoin}
            lang="bash"
            theme="css-variables"
          />
          <p class="step-note">
            Sharing a model instead? Swap <code>--harness</code> for
            <code>--model</code> and <code>--endpoint</code>.
          </p>
        </li>
      </ol>
      <div class="setup-actions">
        <a class="btn btn-paint" href="/guides/quickstart/">Read the quick start</a>
        <a class="btn btn-filete" href="/reference/cli/">CLI reference</a>
      </div>
    </section>
  </main>

  <footer class="lander-footer">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="painted footer-mark">Gambi</p>
        <p class="footer-tag">
          Bring your model. Bring your harness. Keep your keys.
        </p>
      </div>
      <nav class="footer-col" aria-label="Guides">
        <p class="footer-label">Guides</p>
        <a href="/guides/quickstart/">Quick start</a>
        <a href="/guides/bring-your-harness/">Bring your harness</a>
        <a href="/guides/patterns/">Patterns</a>
        <a href="/guides/remote-providers/">Remote providers</a>
      </nav>
      <nav class="footer-col" aria-label="Reference">
        <p class="footer-label">Reference</p>
        <a href="/reference/cli/">CLI</a>
        <a href="/reference/sdk/">SDK</a>
        <a href="/reference/api/">API</a>
        <a href="/reference/observability/">Observability</a>
      </nav>
      <nav class="footer-col" aria-label="Project">
        <p class="footer-label">Project</p>
        <a href="/explanation/tunnel-first/">How tunnels work</a>
        <a href="/explanation/why-gambi/">Why "gambi"?</a>
        <a href="https://github.com/arthurbm/gambi" rel="noopener">GitHub</a>
        <a href="https://www.npmjs.com/package/gambi" rel="noopener">npm</a>
      </nav>
    </div>
    <div class="footer-strip">
      <span>Feito na gambiarra, for networks you trust.</span>
      <span>Docs built {deployDate}</span>
    </div>
  </footer>
</div>

<style is:global>
  /* World tokens live on the splash route only; docs pages keep theirs. */
  :root[data-has-hero] {
    --f-ground: #eef0ea;
    --f-ground-2: #e2e6dc;
    --f-board: #fbfbf6;
    --f-ink: #161a22;
