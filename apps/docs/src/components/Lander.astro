  /* --------------------------------------------------------------------
     Layers: one sign inside another, the outer two still in chalk
     -------------------------------------------------------------------- */

  .layer-stack {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.25rem;
    padding: 0;
    list-style: none;
  }

  /* Three boards, outermost first. Only the bottom one is painted. */
  .layer {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) 2fr;
    align-items: baseline;
