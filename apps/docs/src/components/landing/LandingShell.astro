---
import type { landingLocales } from "@/lib/landing-locales";

interface Props {
  copy: (typeof landingLocales)[keyof typeof landingLocales];
}

const { copy } = Astro.props;
---

<main class="mx-auto flex min-h-svh max-w-3xl flex-col px-6 py-8 sm:px-10 sm:py-12">
  <nav class="flex items-center justify-between gap-4" aria-label={copy.languageNavLabel}>
    <span class="text-sm font-medium">{copy.brandLabel}</span>
    <a
      class="rounded-md px-2 py-1 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
      href={copy.switchLocalePath}
      hreflang={copy.switchLocalePath === "/" ? "en" : "pt-BR"}
    >
      {copy.switchLocaleLabel}
    </a>
  </nav>

  <section class="my-auto py-20" aria-labelledby="landing-heading">
    <p class="mb-4 text-sm font-medium text-muted-foreground">{copy.eyebrow}</p>
    <h1 id="landing-heading" class="text-4xl font-semibold tracking-tight sm:text-5xl">
      {copy.heading}
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">
      {copy.summary}
    </p>
    <a
      class="mt-8 inline-flex rounded-md border border-border px-4 py-2 text-sm font-medium hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
      href="/guides/quickstart/"
    >
      {copy.quickStartLabel}
    </a>
  </section>
</main>
